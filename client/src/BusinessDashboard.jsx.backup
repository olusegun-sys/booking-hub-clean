// client/src/pages/BusinessDashboard.jsx
// =============================================
// BUSINESS DASHBOARD - COMPLETE PRODUCTION VERSION
// Includes: Quick Actions, Booking Codes, Naira currency, Full design
// =============================================

import React, { useState, useEffect, useCallback } from 'react';
import { 
  Home, 
  Calendar, 
  Users, 
  Settings, 
  Plus, 
  Edit, 
  Trash2, 
  X,
  ChevronLeft,
  ChevronRight,
  Bed,
  DollarSign,
  TrendingUp,
  Clock,
  AlertCircle,
  LogOut,
  User,
  Image,
  Building,
  Mail,
  Phone,
  MapPin,
  Info,
  Star,
  CreditCard,
  BarChart,
  List,
  Grid,
  Search,
  Filter,
  Zap,
  Image as ImageIcon,
  Clock as ClockIcon,
  Eye
} from 'lucide-react';
import toast from 'react-hot-toast';

// =============================================
// IMPORTS - Files are in the same directory (src/)
// =============================================
import BookingLimitBanner from './BookingLimitBanner';
import UpgradeModal from './UpgradeModal';

const BusinessDashboard = () => {
  // ==========================================
  // STATE MANAGEMENT
  // ==========================================
  const [activeTab, setActiveTab] = useState('dashboard');
  const [business, setBusiness] = useState(null);
  const [rooms, setRooms] = useState([]);
  const [bookings, setBookings] = useState([]);
  const [staff, setStaff] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showModal, setShowModal] = useState(false);
  const [modalType, setModalType] = useState('add');
  const [editingRoom, setEditingRoom] = useState(null);
  const [isMobile, setIsMobile] = useState(window.innerWidth < 768);
  const [subscription, setSubscription] = useState(null);
  const [showUpgradeModal, setShowUpgradeModal] = useState(false);
  const [bookingStats, setBookingStats] = useState({
    total: 0,
    pending: 0,
    confirmed: 0,
    completed: 0,
    revenue: 0
  });
  const [roomForm, setRoomForm] = useState({
    name: '',
    description: '',
    price: '',
    capacity: '',
    amenities: [],
    images: []
  });

  // ==========================================
  // MOBILE DETECTION
  // ==========================================
  useEffect(() => {
    const handleResize = () => {
      setIsMobile(window.innerWidth < 768);
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // ==========================================
  // FETCH BUSINESS DATA
  // ==========================================
  const fetchBusinessData = useCallback(async () => {
    try {
      setLoading(true);
      const token = localStorage.getItem('token');
      
      // Get business profile
      const profileRes = await fetch('/api/businesses/me', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (profileRes.ok) {
        const profileData = await profileRes.json();
        setBusiness(profileData.data);
      }

      // Get rooms
      const roomsRes = await fetch('/api/rooms', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (roomsRes.ok) {
        const roomsData = await roomsRes.json();
        setRooms(roomsData.data || []);
      }

      // Get bookings
      const bookingsRes = await fetch('/api/bookings', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (bookingsRes.ok) {
        const bookingsData = await bookingsRes.json();
        const bookingsList = bookingsData.data || [];
        setBookings(bookingsList);
        
        // Calculate stats
        const stats = {
          total: bookingsList.length,
          pending: bookingsList.filter(b => b.status === 'pending').length,
          confirmed: bookingsList.filter(b => b.status === 'confirmed').length,
          completed: bookingsList.filter(b => b.status === 'completed').length,
          revenue: bookingsList
            .filter(b => b.status === 'confirmed' || b.status === 'completed')
            .reduce((sum, b) => sum + (b.total_price || 0), 0)
        };
        setBookingStats(stats);
      }

      // Get staff
      const staffRes = await fetch('/api/staff', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (staffRes.ok) {
        const staffData = await staffRes.json();
        setStaff(staffData.data || []);
      }

      // Get subscription status
      const subRes = await fetch('/api/subscriptions/status', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      
      if (subRes.ok) {
        const subData = await subRes.json();
        setSubscription(subData.data);
      }

    } catch (error) {
      console.error('Error fetching business data:', error);
      toast.error('Failed to load dashboard data');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchBusinessData();
  }, [fetchBusinessData]);

  // ==========================================
  // HANDLE LOGOUT
  // ==========================================
  const handleLogout = () => {
    localStorage.removeItem('token');
    localStorage.removeItem('user');
    window.location.href = '/';
  };

  // ==========================================
  // ROOM CRUD OPERATIONS
  // ==========================================
  const handleAddRoom = async () => {
    try {
      const token = localStorage.getItem('token');
      const response = await fetch('/api/rooms', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(roomForm)
      });

      if (response.ok) {
        const data = await response.json();
        setRooms([...rooms, data.data]);
        setShowModal(false);
        setRoomForm({ name: '', description: '', price: '', capacity: '', amenities: [], images: [] });
        toast.success('Room added successfully!');
        fetchBusinessData();
      } else {
        const error = await response.json();
        toast.error(error.message || 'Failed to add room');
      }
    } catch (error) {
      console.error('Error adding room:', error);
      toast.error('Failed to add room');
    }
  };

  const handleEditRoom = async () => {
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`/api/rooms/${editingRoom.id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify(roomForm)
      });

      if (response.ok) {
        const data = await response.json();
        setRooms(rooms.map(r => r.id === data.data.id ? data.data : r));
        setShowModal(false);
        setEditingRoom(null);
        setRoomForm({ name: '', description: '', price: '', capacity: '', amenities: [], images: [] });
        toast.success('Room updated successfully!');
        fetchBusinessData();
      } else {
        const error = await response.json();
        toast.error(error.message || 'Failed to update room');
      }
    } catch (error) {
      console.error('Error updating room:', error);
      toast.error('Failed to update room');
    }
  };

  const handleDeleteRoom = async (roomId) => {
    if (!confirm('Are you sure you want to delete this room?')) return;

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`/api/rooms/${roomId}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        setRooms(rooms.filter(r => r.id !== roomId));
        toast.success('Room deleted successfully!');
        fetchBusinessData();
      } else {
        const error = await response.json();
        toast.error(error.message || 'Failed to delete room');
      }
    } catch (error) {
      console.error('Error deleting room:', error);
      toast.error('Failed to delete room');
    }
  };

  // ==========================================
  // MODAL CONTROLS
  // ==========================================
  const openAddModal = () => {
    setModalType('add');
    setEditingRoom(null);
    setRoomForm({ name: '', description: '', price: '', capacity: '', amenities: [], images: [] });
    setShowModal(true);
  };

  const openEditModal = (room) => {
    setModalType('edit');
    setEditingRoom(room);
    setRoomForm({
      name: room.name,
      description: room.description || '',
      price: room.price,
      capacity: room.capacity || '',
      amenities: room.amenities || [],
      images: room.images || []
    });
    setShowModal(true);
  };

  // ==========================================
  // NAVIGATION TABS
  // ==========================================
  const tabs = [
    { id: 'dashboard', label: 'Dashboard', icon: Home },
    { id: 'rooms', label: 'Rooms', icon: Bed },
    { id: 'bookings', label: 'Bookings', icon: Calendar },
    { id: 'profile', label: 'Profile', icon: User },
    { id: 'staff', label: 'Staff', icon: Users },
    { id: 'settings', label: 'Settings', icon: Settings }
  ];

  // ==========================================
  // RENDER DASHBOARD TAB - COMPLETE WITH ALL DESIGN
  // ==========================================
  const renderDashboard = () => (
    <div className="space-y-6">
      {/* Stats Cards - Full Design */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Total Revenue</p>
              <p className="text-2xl font-bold text-gray-800">₦{bookingStats.revenue.toLocaleString()}</p>
              <p className="text-xs text-gray-400 mt-1">Lifetime revenue</p>
            </div>
            <div className="bg-green-100 p-3 rounded-full">
              <DollarSign className="w-6 h-6 text-green-600" />
            </div>
          </div>
        </div>
        
        <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Total Bookings</p>
              <p className="text-2xl font-bold text-gray-800">{bookingStats.total}</p>
              <p className="text-xs text-gray-400 mt-1">Total bookings received</p>
            </div>
            <div className="bg-blue-100 p-3 rounded-full">
              <Calendar className="w-6 h-6 text-blue-600" />
            </div>
          </div>
        </div>
        
        <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-gray-500">Active Rooms</p>
              <p className="text-2xl font-bold text-gray-800">{rooms.length}</p>
              <p className="text-xs text-gray-400 mt-1">Total rooms</p>
            </div>
            <div className="bg-indigo-100 p-3 rounded-full">
              <Bed className="w-6 h-6 text-indigo-600" />
            </div>
          </div>
        </div>
      </div>

      {/* Subscription Banner */}
      {subscription && (
        <BookingLimitBanner 
          subscription={subscription}
          onUpgrade={() => setShowUpgradeModal(true)}
          isMobile={isMobile}
        />
      )}

      {/* Quick Actions */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
        <button
          onClick={openAddModal}
          className="bg-indigo-50 hover:bg-indigo-100 transition-colors rounded-xl p-4 text-center border border-indigo-100"
        >
          <Plus className="w-6 h-6 text-indigo-600 mx-auto mb-1" />
          <span className="text-sm font-medium text-gray-700">Add Room</span>
        </button>
        <button
          onClick={() => setActiveTab('profile')}
          className="bg-blue-50 hover:bg-blue-100 transition-colors rounded-xl p-4 text-center border border-blue-100"
        >
          <ImageIcon className="w-6 h-6 text-blue-600 mx-auto mb-1" />
          <span className="text-sm font-medium text-gray-700">Update Images</span>
        </button>
        <button
          onClick={() => setActiveTab('settings')}
          className="bg-yellow-50 hover:bg-yellow-100 transition-colors rounded-xl p-4 text-center border border-yellow-100"
        >
          <ClockIcon className="w-6 h-6 text-yellow-600 mx-auto mb-1" />
          <span className="text-sm font-medium text-gray-700">Set Hours</span>
        </button>
        <button
          onClick={() => window.open(`/${business?.slug}`, '_blank')}
          className="bg-green-50 hover:bg-green-100 transition-colors rounded-xl p-4 text-center border border-green-100"
        >
          <Eye className="w-6 h-6 text-green-600 mx-auto mb-1" />
          <span className="text-sm font-medium text-gray-700">View Page</span>
        </button>
      </div>

      {/* Recent Bookings - Full Design with Booking Codes */}
      <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="px-6 py-4 border-b border-gray-100">
          <h3 className="font-semibold text-gray-800">Recent Bookings</h3>
        </div>
        {bookings.length === 0 ? (
          <div className="p-6 text-center">
            <Calendar className="w-12 h-12 text-gray-300 mx-auto mb-3" />
            <p className="text-gray-500">No bookings yet</p>
          </div>
        ) : (
          <div className="divide-y divide-gray-100">
            {bookings.slice(0, 5).map((booking) => (
              <div key={booking.id} className="px-6 py-4 flex items-center justify-between hover:bg-gray-50 transition-colors">
                <div>
                  <p className="font-medium text-gray-800">{booking.customer_name}</p>
                  <p className="text-sm text-gray-500">
                    ₦{booking.total_price} • {booking.room_name || 'Room'}
                  </p>
                  <p className="text-xs text-gray-400 font-mono">
                    {booking.booking_code || booking.id?.substring(0, 15) || 'N/A'}
                  </p>
                </div>
                <span className={`px-3 py-1 text-xs font-medium rounded-full ${
                  booking.status === 'confirmed' ? 'bg-green-100 text-green-700' :
                  booking.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                  booking.status === 'completed' ? 'bg-blue-100 text-blue-700' :
                  'bg-red-100 text-red-700'
                }`}>
                  {booking.status || 'pending'}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );

  // ==========================================
  // RENDER ROOMS TAB
  // ==========================================
  const renderRooms = () => (
    <div className="space-y-4">
      <div className="flex items-center justify-between">
        <h3 className="font-semibold text-gray-800">Manage Rooms</h3>
        <button
          onClick={openAddModal}
          className="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors flex items-center gap-2 text-sm"
        >
          <Plus className="w-4 h-4" />
          Add Room
        </button>
      </div>

      {rooms.length === 0 ? (
        <div className="bg-gray-50 rounded-lg p-8 text-center">
          <Bed className="w-12 h-12 text-gray-300 mx-auto mb-3" />
          <p className="text-gray-500">No rooms added yet</p>
          <button
            onClick={openAddModal}
            className="mt-2 text-indigo-600 hover:text-indigo-700 font-medium text-sm"
          >
            Add your first room
          </button>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {rooms.map((room) => (
            <div key={room.id} className="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
              <div className="flex items-start justify-between">
                <div className="flex-1">
                  <h4 className="font-semibold text-gray-800">{room.name}</h4>
                  <p className="text-sm text-gray-600 mt-1 line-clamp-2">{room.description || 'No description'}</p>
                  <div className="mt-2 flex flex-wrap gap-2">
                    <span className="text-sm font-semibold text-indigo-600">₦{room.price}</span>
                    {room.capacity && (
                      <span className="text-sm text-gray-500">• {room.capacity} guests</span>
                    )}
                  </div>
                  {room.amenities && room.amenities.length > 0 && (
                    <div className="mt-2 flex flex-wrap gap-1">
                      {room.amenities.slice(0, 3).map((amenity, i) => (
                        <span key={i} className="text-xs bg-gray-100 px-2 py-1 rounded-full text-gray-600">
                          {amenity}
                        </span>
                      ))}
                      {room.amenities.length > 3 && (
                        <span className="text-xs text-gray-400">+{room.amenities.length - 3}</span>
                      )}
                    </div>
                  )}
                </div>
                <div className="flex gap-2 ml-4">
                  <button
                    onClick={() => openEditModal(room)}
                    className="text-blue-600 hover:text-blue-700 p-1"
                  >
                    <Edit className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => handleDeleteRoom(room.id)}
                    className="text-red-600 hover:text-red-700 p-1"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );

  // ==========================================
  // RENDER BOOKINGS TAB
  // ==========================================
  const renderBookings = () => (
    <div className="space-y-4">
      <h3 className="font-semibold text-gray-800">All Bookings</h3>
      
      {bookings.length === 0 ? (
        <div className="bg-gray-50 rounded-lg p-8 text-center">
          <Calendar className="w-12 h-12 text-gray-300 mx-auto mb-3" />
          <p className="text-gray-500">No bookings yet</p>
        </div>
      ) : (
        <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead className="bg-gray-50">
                <tr>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Customer</th>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Room</th>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Check In</th>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Check Out</th>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Amount</th>
                  <th className="px-6 py-3 text-left text-gray-600 font-medium">Status</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-100">
                {bookings.map((booking) => (
                  <tr key={booking.id} className="hover:bg-gray-50 transition-colors">
                    <td className="px-6 py-3">
                      <div>
                        <p className="font-medium text-gray-800">{booking.customer_name}</p>
                        <p className="text-xs text-gray-500">{booking.customer_email}</p>
                      </div>
                    </td>
                    <td className="px-6 py-3">{booking.room_name || 'N/A'}</td>
                    <td className="px-6 py-3">{booking.check_in}</td>
                    <td className="px-6 py-3">{booking.check_out}</td>
                    <td className="px-6 py-3 font-semibold">₦{booking.total_price}</td>
                    <td className="px-6 py-3">
                      <span className={`px-3 py-1 text-xs font-medium rounded-full ${
                        booking.status === 'confirmed' ? 'bg-green-100 text-green-700' :
                        booking.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                        booking.status === 'completed' ? 'bg-blue-100 text-blue-700' :
                        'bg-red-100 text-red-700'
                      }`}>
                        {booking.status || 'pending'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  );

  // ==========================================
  // RENDER PROFILE TAB
  // ==========================================
  const renderProfile = () => (
    <div className="space-y-4">
      <h3 className="font-semibold text-gray-800">Business Profile</h3>
      <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div className="space-y-4">
          <div className="flex items-center gap-4">
            <div className="w-20 h-20 bg-indigo-100 rounded-full flex items-center justify-center">
              {business?.logo_url ? (
                <img src={business.logo_url} alt="Logo" className="w-20 h-20 rounded-full object-cover" />
              ) : (
                <Building className="w-10 h-10 text-indigo-600" />
              )}
            </div>
            <div>
              <h2 className="text-xl font-bold text-gray-800">{business?.name || 'Business Name'}</h2>
              <p className="text-gray-500">{business?.business_type || 'Business Type'}</p>
            </div>
          </div>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label className="text-sm text-gray-500">Email</label>
              <p className="font-medium">{business?.email || 'N/A'}</p>
            </div>
            <div>
              <label className="text-sm text-gray-500">Phone</label>
              <p className="font-medium">{business?.phone || 'N/A'}</p>
            </div>
            <div className="col-span-2">
              <label className="text-sm text-gray-500">Address</label>
              <p className="font-medium">{business?.address || 'N/A'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );

  // ==========================================
  // RENDER STAFF TAB
  // ==========================================
  const renderStaff = () => (
    <div className="space-y-4">
      <h3 className="font-semibold text-gray-800">Staff Management</h3>
      
      {staff.length === 0 ? (
        <div className="bg-gray-50 rounded-lg p-8 text-center">
          <Users className="w-12 h-12 text-gray-300 mx-auto mb-3" />
          <p className="text-gray-500">No staff members added</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {staff.map((member) => (
            <div key={member.id} className="bg-white rounded-lg shadow-sm border border-gray-100 p-4">
              <div className="flex items-center gap-3">
                <div className="bg-indigo-100 p-2 rounded-full">
                  <User className="w-5 h-5 text-indigo-600" />
                </div>
                <div>
                  <p className="font-semibold text-gray-800">{member.name}</p>
                  <p className="text-sm text-gray-500">{member.email}</p>
                  <p className="text-xs text-gray-400">{member.role || 'Staff'}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );

  // ==========================================
  // RENDER SETTINGS TAB
  // ==========================================
  const renderSettings = () => (
    <div className="space-y-4">
      <h3 className="font-semibold text-gray-800">Business Settings</h3>
      
      <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div className="space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700">Business Name</label>
            <p className="mt-1 text-gray-800">{business?.name || 'N/A'}</p>
          </div>
          
          <div>
            <label className="block text-sm font-medium text-gray-700">Email</label>
            <p className="mt-1 text-gray-800">{business?.email || 'N/A'}</p>
          </div>
          
          <div>
            <label className="block text-sm font-medium text-gray-700">Phone</label>
            <p className="mt-1 text-gray-800">{business?.phone || 'N/A'}</p>
          </div>
          
          <div>
            <label className="block text-sm font-medium text-gray-700">Address</label>
            <p className="mt-1 text-gray-800">{business?.address || 'N/A'}</p>
          </div>
          
          <div className="pt-4 border-t border-gray-100">
            <button
              onClick={() => setShowUpgradeModal(true)}
              className="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition-colors text-sm flex items-center gap-2"
            >
              <TrendingUp className="w-4 h-4" />
              Upgrade Plan
            </button>
          </div>
        </div>
      </div>
    </div>
  );

  // ==========================================
  // RENDER TAB CONTENT
  // ==========================================
  const renderTabContent = () => {
    switch (activeTab) {
      case 'dashboard': return renderDashboard();
      case 'rooms': return renderRooms();
      case 'bookings': return renderBookings();
      case 'profile': return renderProfile();
      case 'staff': return renderStaff();
      case 'settings': return renderSettings();
      default: return renderDashboard();
    }
  };

  // ==========================================
  // LOADING STATE
  // ==========================================
  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Loading dashboard...</p>
        </div>
      </div>
    );
  }

  // ==========================================
  // MAIN RENDER
  // ==========================================
  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header - With Business Name */}
      <header className="bg-white border-b border-gray-200 sticky top-0 z-30">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex items-center justify-between h-16">
            <div className="flex items-center gap-3">
              {business?.logo_url ? (
                <img src={business.logo_url} alt="Logo" className="w-8 h-8 rounded-lg object-cover" />
              ) : (
                <div className="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                  <span className="text-white font-bold text-sm">BH</span>
                </div>
              )}
              <div>
                <h1 className="font-semibold text-gray-800 text-lg leading-none">
                  {business?.name || 'Dashboard'}
                </h1>
                <p className="text-xs text-gray-500">{business?.business_type || 'Business'}</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <button
                onClick={() => window.location.href = '/'}
                className="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-gray-100 transition-colors"
                title="Home"
              >
                <Home className="w-5 h-5" />
              </button>
              <button
                onClick={handleLogout}
                className="text-gray-600 hover:text-red-600 p-2 rounded-lg hover:bg-gray-100 transition-colors"
                title="Logout"
              >
                <LogOut className="w-5 h-5" />
              </button>
            </div>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {/* Tabs */}
        <div className="mb-6">
          <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-1 flex flex-wrap gap-1">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                  activeTab === tab.id
                    ? 'bg-indigo-600 text-white'
                    : 'text-gray-600 hover:bg-gray-50'
                }`}
              >
                <tab.icon className="w-4 h-4 inline mr-2" />
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        {/* Tab Content */}
        <div>
          {renderTabContent()}
        </div>
      </div>

      {/* Room Modal */}
      {showModal && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl max-w-md w-full max-h-[90vh] overflow-y-auto">
            <div className="p-6">
              <div className="flex items-center justify-between mb-4">
                <h3 className="text-xl font-bold text-gray-800">
                  {modalType === 'add' ? 'Add New Room' : 'Edit Room'}
                </h3>
                <button
                  onClick={() => setShowModal(false)}
                  className="text-gray-400 hover:text-gray-600"
                >
                  <X className="w-6 h-6" />
                </button>
              </div>

              <form onSubmit={(e) => {
                e.preventDefault();
                modalType === 'add' ? handleAddRoom() : handleEditRoom();
              }}>
                <div className="space-y-4">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Room Name *
                    </label>
                    <input
                      type="text"
                      value={roomForm.name}
                      onChange={(e) => setRoomForm({ ...roomForm, name: e.target.value })}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Description
                    </label>
                    <textarea
                      value={roomForm.description}
                      onChange={(e) => setRoomForm({ ...roomForm, description: e.target.value })}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                      rows="3"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Price (₦) *
                    </label>
                    <input
                      type="number"
                      value={roomForm.price}
                      onChange={(e) => setRoomForm({ ...roomForm, price: e.target.value })}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Capacity (guests)
                    </label>
                    <input
                      type="number"
                      value={roomForm.capacity}
                      onChange={(e) => setRoomForm({ ...roomForm, capacity: e.target.value })}
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1">
                      Amenities (comma separated)
                    </label>
                    <input
                      type="text"
                      value={roomForm.amenities.join(', ')}
                      onChange={(e) => setRoomForm({ 
                        ...roomForm, 
                        amenities: e.target.value.split(',').map(s => s.trim()).filter(Boolean)
                      })}
                      placeholder="WiFi, TV, AC, etc."
                      className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    />
                  </div>
                </div>

                <div className="flex gap-3 mt-6">
                  <button
                    type="submit"
                    className="flex-1 bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition-colors font-semibold"
                  >
                    {modalType === 'add' ? 'Add Room' : 'Update Room'}
                  </button>
                  <button
                    type="button"
                    onClick={() => setShowModal(false)}
                    className="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg hover:bg-gray-300 transition-colors font-semibold"
                  >
                    Cancel
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      )}

      {/* Upgrade Modal */}
      <UpgradeModal
        isOpen={showUpgradeModal}
        onClose={() => setShowUpgradeModal(false)}
        onUpgrade={(plan) => {
          fetchBusinessData();
          toast.success(`Upgraded to ${plan} plan!`);
        }}
        currentPlan={subscription?.plan}
      />
    </div>
  );
};

export default BusinessDashboard;